"use strict";
var wall = document.querySelector(".wall");
var spider = document.querySelector(".spider");
document.addEventListener("click", function(e) {
    if (!wall.contains(e.target)) return;
    var wallRect = wall.getBoundingClientRect();
    var x = e.clientX - wallRect.left - wall.clientLeft;
    var y = e.clientY - wallRect.top - wall.clientTop;
    var spiderLeft = x - spider.offsetWidth / 2;
    var spiderTop = y - spider.offsetHeight / 2;
    var maxLeft = wall.clientWidth - spider.offsetWidth;
    var maxTop = wall.clientHeight - spider.offsetHeight;
    spiderLeft = Math.max(0, Math.min(spiderLeft, maxLeft));
    spiderTop = Math.max(0, Math.min(spiderTop, maxTop));
    spider.style.left = "".concat(spiderLeft, "px");
    spider.style.top = "".concat(spiderTop, "px");
});

